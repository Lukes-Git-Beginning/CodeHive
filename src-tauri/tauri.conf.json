{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CodeHive",
  "version": "0.1.0",
  "identifier": "com.codehive.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CodeHive",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true,
        "decorations": true,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Multi-Agent Coding Orchestrator",
    "longDescription": "CodeHive orchestrates specialized AI agents to work on your coding projects. Features Plan/Execute/Verify workflow with Opus/Sonnet/Haiku model routing.",
    "copyright": "2026 Luke",
    "category": "DeveloperTool"
  },
  "plugins": {}
}
